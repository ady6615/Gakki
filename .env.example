# =============================================================================
# Gakki Music Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# =============================================================================

# Node environment: development | production | test
NODE_ENV=development

# --- Database ---
# PostgreSQL connection string (pgvector extension required for future AI features)
DATABASE_URL=postgresql://gakki:gakki@localhost:5432/gakki

# --- Discord ---
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Application (client) ID from Discord developer portal
DISCORD_CLIENT_ID=

# --- API Server ---
API_PORT=3000

# --- Logging ---
# Level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
