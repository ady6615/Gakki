{
  "name": "gakki",
  "version": "0.1.0",
  "private": true,
  "description": "A modular music and voice platform powered by AI, with Discord and future cross-platform support",
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/web",
    "packages/desktop"
  ],
  "scripts": {
    "dev": "npm run dev -w @gakki/server",
    "dev:web": "npm run dev -w @gakki/web",
    "build": "npm run build -w @gakki/core && npm run build -w @gakki/server && npm run build -w @gakki/web",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/server/tsconfig.json",
    "evaluate:recommendations": "tsx packages/server/src/scripts/evaluate-recommendations.ts",
    "test:phase6": "tsx packages/server/src/__tests__/phase6.test.ts",
    "test:phase7": "tsx packages/server/src/__tests__/phase7.test.ts",
    "test:phase8": "tsx packages/server/src/__tests__/phase8.test.ts",
    "test:transitions": "tsx packages/server/src/scripts/test-transitions.ts",
    "test:phase12": "tsx packages/server/src/__tests__/phase12.test.ts",
    "test:phase13": "tsx packages/server/src/__tests__/phase13.test.ts",
    "test:quickplay": "tsx packages/server/src/__tests__/__smart_history_quickplay.test.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "play-dl": "^1.9.7",
    "soundcloud.ts": "^0.7.4"
  }
}
